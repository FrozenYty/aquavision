# Model weights, datasets and video: never in the repository. They live in Releases or external
# storage, linked from the README with a checksum.
*.pt
*.onnx
*.engine
data/
datasets/
runs/
*.mp4
*.avi
*.mov

# Secrets and local configuration.
.env
.env.*
!.env.example

# Office lock files and editor scratch.
~$*
*.tmp

# OS clutter.
.DS_Store
Thumbs.db
desktop.ini

# Python.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Editors.
.vscode/
.idea/

# Rendering and debug by-products.
_probe.pdf
*.pdf.tmp

# Submission artefacts: the frozen .docx and its generated PDFs live outside the repository, in a
# folder beside it. The Markdown in docs/ is what continues to change; see CONTRIBUTING §6.
*.docx

# pytest scratch space, created by tests/conftest.py.
tests/tmp/
# PlatformIO: the build tree and the toolchain cache are both large and regenerable.
.pio/
.pio-core/
